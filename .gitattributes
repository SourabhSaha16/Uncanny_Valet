# Normalise line endings; keep Unity YAML diffable
* text=auto
*.cs text diff=csharp
*.md text
*.sh text eol=lf
*.ps1 text eol=crlf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.asmdef text eol=lf

# Binary assets
*.png binary
*.psd binary
*.aseprite binary
*.wav binary
*.ogg binary
*.mp3 binary
*.ttf binary

# Built Web player published to GitHub Pages: never touch line endings
site/** -text

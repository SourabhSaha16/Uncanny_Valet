  m_Script: {fileID: 11500000, guid: 807f795b1d6d8b74a9f5588b42e528f0, type: 3}
  m_Name: NightPlanConfig
  m_EditorClassIdentifier: UncannyValet.Night::UncannyValet.Night.NightPlanConfig
  _nights:
  - _night: 1
    _maxWaitingCars: 1
    _arrivalGapScale: 3.7
    _activeSpots: 4
    _evChance: 0
    _dirtyChance: 0
    _chargingOpen: 0
    _washOpen: 0
    _newTonight: 'Simple: one car at a time.'
  - _night: 2
    _maxWaitingCars: 3
    _arrivalGapScale: 3.2
    _activeSpots: 4
    _evChance: 0
    _dirtyChance: 0
    _chargingOpen: 0
    _washOpen: 0
    _newTonight: 'Things get messy: several cars waiting, parallel pickups and drop-offs.'
  - _night: 3
    _maxWaitingCars: 3
    _arrivalGapScale: 2.5
    _activeSpots: 5
    _evChance: 0.4
    _dirtyChance: 0
    _chargingOpen: 1
    _washOpen: 0
    _newTonight: 'EV charging unlocked: blue EVs earn a bonus tip when handed back
      fully charged. Use the charging station.'
  - _night: 4
    _maxWaitingCars: 3
    _arrivalGapScale: 2.4
    _activeSpots: 5
    _evChance: 0
    _dirtyChance: 0.4
    _chargingOpen: 0
    _washOpen: 1
    _newTonight: 'Dirty cars: wash them at the car wash (one slot) before parking.
      Extra tip for clean cars; unwashed cars pay $0. No EVs tonight.'
  - _night: 5
    _maxWaitingCars: 3
    _arrivalGapScale: 2.3
    _activeSpots: 5
    _evChance: 0.3
    _dirtyChance: 0.3
    _chargingOpen: 1
    _washOpen: 1
    _newTonight: 'Everything at once: parallel cars, EVs and dirty cars.'
  - _night: 6
    _maxWaitingCars: 3
    _arrivalGapScale: 2.2
    _activeSpots: 5
    _evChance: 0.3
    _dirtyChance: 0.3
    _chargingOpen: 1
    _washOpen: 1
    _newTonight: 'Everything at once: parallel cars, EVs and dirty cars.'
  - _night: 7
    _maxWaitingCars: 3
    _arrivalGapScale: 2.0
    _activeSpots: 5
    _evChance: 0.3
    _dirtyChance: 0.3
    _chargingOpen: 1
    _washOpen: 1
    _newTonight: 'Everything at once: parallel cars, EVs and dirty cars.'

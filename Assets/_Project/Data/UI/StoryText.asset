%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 955474121033c354092908ff48dbc962, type: 3}
  m_Name: StoryText
  m_EditorClassIdentifier: UncannyValet.Core::UncannyValet.Core.Story.StoryTextAsset
  _worlds:
  - _world: 1
    _worldName: MIDGARD
    _accent: {r: 0.8901961, g: 0.7254902, b: 0.47843137, a: 1}
    _accentSecond: {r: 0.43529412, g: 0.7019608, b: 0.41960785, a: 1}
  - _world: 2
    _worldName: VANAHEIM
    _accent: {r: 1, g: 0.78431374, b: 0.22745098, a: 1}
    _accentSecond: {r: 0.70980394, g: 0.2509804, b: 0.18039216, a: 1}
  _lots:
  - _lot:
      _world: 1
      _kind: 1
    _introLines:
    - A SUNNY DAY AT THE LOCAL DINER.
    - PARK THE CARS, THEN BRING THEM BACK.
    - EVERYONE LAUGHS AT THE NAME THOR.
  - _lot:
      _world: 1
      _kind: 2
    _introLines:
    - THE TOWN FAIR LIGHTS UP THE NIGHT.
    - THE WHOLE TOWN WANTS A PARKING SPOT.
    - SHE KNOWS MORE THAN SHE SAYS.
  - _lot:
      _world: 2
      _kind: 1
    _introLines:
    - A RED BARN AMONG GOLDEN WHEAT.
    - MUDDY CARS NEED A WASH AT THE TROUGH.
    - THE WATERWHEEL TURNS SLOWLY.
  - _lot:
      _world: 2
      _kind: 2
    _introLines:
    - THE STORM IS OVER. THE FEAST IS ON.
    - MUD EVERYWHERE, TROUGHS FAR AWAY.
    - SOMETHING SMELLS LIKE THUNDER.
  _powers:
  - _power: 1
    _description: DASH IN A FLASH OF LIGHTNING, OR BOOST YOUR CAR.
    _farewell: WELL PARKED, DEAR. THE LIGHTNING IS YOURS NOW. MIND THE FAIR ON YOUR
      WAY OUT.
  - _power: 2
    _description: BLOW A GUST THAT CLEARS A LANE OF CARS AND PEOPLE.
    _farewell: THE STORM TOLD ME YOU WOULD COME. TAKE ITS WIND AND LEAVE MY BARN
      STANDING.
  - _power: 3
    _description: STOP THE WORLD FOR A FEW SECONDS WHILE YOU MOVE.
    _farewell: TIME IS A RIVER. FOR A MOMENT YOU MAY HOLD IT STILL.
  - _power: 4
    _description: CALL THE HAMMER BACK TO YOUR HAND.
    _farewell: THE HAMMER HAS MISSED YOU, HEIR OF THUNDER.
  _generic:
    _trainingTag: TRAINING
    _crazyTag: CRAZY
    _finaleTag: FINALE
    _godFrame: THE TEST OF {0}
    _trainerFrame: 'TRAINER: {0}'
    _goalLine: EARN {0} BLESSINGS TO CLEAR THE LOT
    _newPowerHeading: NEW POWER!
    _upgradeHeading: POWER UPGRADED!
    _keyHint: PRESS {0} TO USE IT
    _sentBackHeading: THROWN BACK!
    _sentBackLines:
    - THE TEST WAS FAILED.
    - THOR FALLS BACK TO MIDGARD.
    _keptHeading: 'POWERS KEPT:'
    _keptNone: NONE YET
    _upgradedMark: +
    _continuedHeading: TO BE CONTINUED
    _continuedLines:
    - THE ROAD GOES ON. MORE REALMS
    - AWAIT THE HAMMER'S HEIR.
    _homeHeading: THOR IS HOME
    _homeLines:
    - ODIN OPENS THE GREAT DOORS.
    - THE VALET SPEAKS FOR THE LAST TIME.
    _earnedHeading: 'POWERS EARNED:'
    _finaleBlessings: 'FINALE BLESSINGS: {0}'
    _prompt: PRESS ANY KEY
